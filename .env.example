# ── SynapseOS configuration ─────────────────────────────────────────────
# Copy to .env (or export these) — every value has a sane offline default.

# Storage. Default: SQLite in backend/data. For Postgres:
# SYNAPSE_DB_URL=postgresql+psycopg2://synapse:synapse@localhost:5432/synapseos
SYNAPSE_DATA_DIR=./data

# Vector store: "lite" (embedded SQLite+numpy) or "qdrant" (needs qdrant-client + URL)
SYNAPSE_VECTOR_BACKEND=lite
SYNAPSE_QDRANT_URL=http://localhost:6333

# Session cache: in-process by default. Set a Redis URL to use Redis.
# SYNAPSE_REDIS_URL=redis://localhost:6379/0

# ── Model layer ────────────────────────────────────────────────────────
# local            = built-in offline extractive synthesizer (no keys needed)
# openai           = OpenAI chat completions API
# anthropic        = Anthropic messages API
# openai_compatible= any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, OpenRouter...)
SYNAPSE_MODEL_PROVIDER=local
SYNAPSE_MODEL_NAME=synapse-local-synth-1
# SYNAPSE_LLM_BASE_URL=http://localhost:11434/v1
# SYNAPSE_LLM_API_KEY=

# Embeddings: "local" (deterministic hashing embedder, offline) or "openai"
SYNAPSE_EMBED_PROVIDER=local

# ── Security ───────────────────────────────────────────────────────────
# Leave unset for dev (open) mode. Set them for anything exposed to a network.
# SYNAPSE_ADMIN_KEY=change-me-admin
# SYNAPSE_API_KEYS=change-me-key-1,change-me-key-2
SYNAPSE_CORS_ORIGINS=*
SYNAPSE_RATE_LIMIT_CAPACITY=240
SYNAPSE_RATE_LIMIT_REFILL=4
SYNAPSE_MAX_BODY_MB=8
SYNAPSE_DOCS=on
